# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. The workflow consumes these from GitHub secrets;
# `.env` is for local dev / record-keeping.
#
# GitHub secrets required by .github/workflows/storage-host.yml:
#   STORAGED_ADMIN_KEY, STORAGED_READ_KEY, STORAGED_PEER_SECRET,
#   STORAGED_PEER_URL (per node), CF_TUNNEL_CREDENTIALS (base64 of
#   conf/tunnel-credentials.json), GH_TOKEN (PAT w/ workflow:write).

# --- object storage service ---
STORAGED_LISTEN=127.0.0.1:5000
STORAGED_PUBLIC_URL=https://storage.chuglii.in
STORAGED_DATA_DIR=D:\storage
STORAGED_NODE_ID=node-a
STORAGED_ROLE=leader
STORAGED_ADMIN_KEY=CHANGE_ME_admin_key
STORAGED_READ_KEY=CHANGE_ME_read_key
STORAGED_PEER_SECRET=CHANGE_ME_peer_secret

# --- replication (install on the follower node too) ---
STORAGED_PEER_ENABLED=true
STORAGED_PEER_URL=http://127.0.0.1:5000
STORAGED_PEER_KEY=CHANGE_ME_peer_secret

# --- cloudflare named tunnel (shared with supabase.chuglii.in) ---
# The runner runs this tunnel via conf/cloudflared.yml + conf/tunnel-
# credentials.json (built from the three fields below). No token required.
CF_TUNNEL_ID=CHANGE_ME_tunnel_id
CF_TUNNEL_ACCOUNT_TAG=CHANGE_ME_account_tag
CF_TUNNEL_SECRET=CHANGE_ME_tunnel_secret
# Base64 of the credentials JSON — set as GitHub secret CF_TUNNEL_CREDENTIALS
CF_TUNNEL_CREDENTIALS_B64=CHANGE_ME_base64_of_credentials_json

# --- keep-alive / watchdog ---
GH_TOKEN=CHANGE_ME_github_token
GH_REPO=CHANGE_ME/CHANGE_ME
WORKFLOW_SELF=storage-host.yml

# --- optional: allow fsync to be skipped (see store.go) ---
# --- torrents (BitTorrent transfers) ---
# anacrolix/torrent defaults to mmap file IO, which on Windows keeps staged
# torrent files locked for the life of the daemon: per-transfer cleanup then
# fails silently and <data_dir>/torrents grows until the disk hits the
# high-water mark (which blocks all writes). 'classic' IO releases the handles
# so staged data is reclaimed after each transfer.
TORRENT_STORAGE_DEFAULT_FILE_IO=classic
# magnets and .torrent files get these announce URLs appended (deduped, added
# on top of their own trackers). HTTP(S) URLs first: they only need outbound
# TCP, which GitHub-hosted runners allow; udp:// and DHT need outbound UDP,
# which runner egress commonly filters. (comma separated; single comma disables)
STORAGED_TORRENT_TRACKERS=https://tracker.opentrackr.org:443/announce,http://tracker.opentrackr.org:1337/announce,http://tracker.openbittorrent.com:80/announce,https://tracker.gbitt.info:443/announce,udp://open.tracker.cl:1337/announce,udp://exodus.desync.com:6969/announce

# --- optional: allow fsync to be skipped (see store.go) ---
# STORAGED_ALLOW_SKIP_FSYNC=0